# OS / OneDrive
Thumbs.db
desktop.ini
.DS_Store
*.tmp
~$*

# Python (pour le code à venir)
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Secrets & config locale
.env
.env.*
!.env.example
.claude/settings.local.json

# Artefacts de fine-tuning (volumineux — ne jamais versionner)
*.gguf
*.safetensors
*.bin
checkpoints/
outputs/
adapters/
wandb/

# Données brutes catalogue (contrainte légale — voir SOURCES_DONNEES.md)
data/raw/
*.dump
*.sql

# Devis persistés par le registre de projets (app/persistance.py).
# Ancré à la racine : sans la barre oblique de tête, la règle attrapait aussi
# tools/donnees/, et la chaîne de données entière disparaissait des commits.
/donnees/

# Chaîne de données catalogue : artefacts reconstructibles.
# Les extraits bruts (catalogue/brut/*.json) et le jeu agrégé sont versionnés —
# ce sont eux qui rendent la chaîne rejouable sans réseau. La page HTML mise en
# cache et la base SQLite s'en déduisent, et n'ont pas à peser dans l'historique.
catalogue/sources/*.html
catalogue/*.sqlite3
